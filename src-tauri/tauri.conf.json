{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rsmd",
  "version": "0.1.0",
  "identifier": "com.leo.rsmd",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "rsmd", "width": 960, "height": 720 }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$HOME/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [],
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdown"], "role": "Viewer", "description": "Markdown document" }
    ]
  }
}
